# Text files are LF in the repository and in every checkout, whatever the
# local core.autocrlf says. Lines further down override this one.
* text=auto eol=lf

# The bundled font is binary data: never convert line endings.
*.otf binary
# The DXF fixtures keep their bytes: CRLF, and one is not UTF-8 by design.
tests/fixtures/*.dxf -text
# The golden copies are the writer's bytes, compared byte for byte.
tests/golden/* -text
